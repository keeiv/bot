# Add these entries to the existing new_bot .env; do not replace other keys.
BOT_API_ENABLED=true
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080
# Same random secret as the website, at least 32 characters.
BOT_API_SECRET=
# Public label shown on the status page.
BOT_REGION=Taipei, Taiwan
# Optional release label or commit SHA.
BOT_VERSION=development
